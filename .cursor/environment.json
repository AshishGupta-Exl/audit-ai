{
  "name": "audit-ai",
  "user": "ubuntu",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "cd backend && .venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
      "description": "FastAPI audit API (http://localhost:8000, docs at /docs)."
    },
    {
      "name": "frontend",
      "command": "cd frontend && npm run dev",
      "description": "Vite dev server for the audit-ai UI (http://localhost:5173), proxies /api to the backend."
    }
  ],
  "ports": [
    { "name": "api", "port": 8000 },
    { "name": "web", "port": 5173 }
  ]
}
